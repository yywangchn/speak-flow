{
  "name": "@speak-flow/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve speak-flow --host 127.0.0.1 --port 4200",
    "db:migrate": "node --env-file-if-exists=.env --import tsx apps/speak-flow/src/database/migrate.ts",
    "db:import-sqlite": "node --env-file-if-exists=.env --import tsx tools/database/import-sqlite.ts",
    "test:postgres": "RUN_POSTGRES_TESTS=true nx test speak-flow --skip-nx-cache",
    "eval:memory": "node --env-file-if-exists=.env --import tsx tools/evals/run-memory-extraction.ts",
    "eval:retrieval": "node --env-file-if-exists=.env --import tsx tools/evals/run-memory-retrieval.ts",
    "eval:stream": "node --env-file-if-exists=.env --import tsx tools/evals/run-chat-stream.ts"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "dependencies": {
    "@angular/common": "~22.0.4",
    "@angular/compiler": "~22.0.4",
    "@angular/core": "~22.0.4",
    "@angular/forms": "~22.0.4",
    "@angular/platform-browser": "~22.0.4",
    "@angular/platform-server": "~22.0.4",
    "@angular/router": "~22.0.4",
    "@angular/ssr": "~22.0.4",
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "pg": "^8.23.0",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.6.0",
    "@analogjs/vitest-angular": "~2.6.0",
    "@angular-devkit/build-angular": "22.0.7",
    "@angular-devkit/core": "~22.0.0",
    "@angular-devkit/schematics": "~22.0.4",
    "@angular/build": "~22.0.4",
    "@angular/cli": "~22.0.4",
    "@angular/compiler-cli": "~22.0.4",
    "@angular/language-service": "~22.0.4",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/vite": "23.1.0",
    "@nx/vitest": "^23.1.0",
    "@nx/web": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@schematics/angular": "~22.0.4",
    "@swc/helpers": "~0.5.18",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^27.1.0",
    "nx": "23.1.0",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "tsx": "^4.23.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "7.3.5",
    "vitest": "~4.1.0"
  }
}
